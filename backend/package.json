{
  "name": "pharmacy-backend",
  "version": "1.0.0",
  "description": "Pharmacy Management System - Backend API",
  "main": "dist/server.js",
  "scripts": {
    "start": "node dist/server.js",
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "tsc",
    "seed": "echo 'Seeding happens automatically on server start'",
    "test": "jest",
    "lint": "eslint . --ext .ts",
